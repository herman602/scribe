# Environment variables override config.toml. Never commit .env.
SCRIBE_DATABASE_PATH=data/app.sqlite3
SCRIBE_GMAIL_CREDENTIALS_PATH=credentials.json
SCRIBE_GMAIL_TOKEN_PATH=data/token.json
SCRIBE_HOST=127.0.0.1
SCRIBE_PORT=8000
SCRIBE_LOG_LEVEL=INFO
SCRIBE_BODY_RETENTION_POLICY=full_text
SCRIBE_DEFAULT_GMAIL_QUERY=
SCRIBE_SYNC_BATCH_SIZE=100
SCRIBE_SYNC_WORKER_LEASE_SECONDS=300
SCRIBE_GMAIL_REQUEST_TIMEOUT_SECONDS=30
SCRIBE_GMAIL_RETRY_MAX_ATTEMPTS=5
SCRIBE_GMAIL_BACKOFF_BASE_SECONDS=1.0
SCRIBE_GMAIL_BACKOFF_MAX_SECONDS=64.0
SCRIBE_GMAIL_MAX_BODY_BYTES=5242880
SCRIBE_GMAIL_MAX_ATTACHMENT_BYTES=26214400
SCRIBE_PDF_MAX_BYTES=10485760
SCRIBE_PDF_MAX_PAGES=30
SCRIBE_PDF_MAX_TEXT_CHARS=200000
SCRIBE_PDF_MAX_PASSWORD_ATTEMPTS=5
SCRIBE_PDF_MAX_SECONDS=10.0
SCRIBE_BODY_SUMMARY_CHARS=1000
SCRIBE_PARSER_CONFIDENCE_THRESHOLD=0.75
SCRIBE_LOCAL_TIMEZONE=Asia/Taipei
